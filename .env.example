# =============================================================================
# PostgreSQL — deve corresponder exatamente ao docker-compose.yml
# =============================================================================
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_secret
POSTGRES_DB=stockflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexão montada a partir das variáveis acima
# SQLAlchemy usa este formato: postgresql+psycopg2://user:pass@host:port/db
DATABASE_URL=postgresql+psycopg2://stockflow:stockflow_secret@localhost:5432/stockflow_db

# =============================================================================
# Aplicação
# =============================================================================
APP_ENV=development      # development | production
APP_DEBUG=true
APP_SECRET_KEY=troque-esta-chave-em-producao

# =============================================================================
# API
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
